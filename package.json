{
  "name": "defi-app-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Modernized DeFi app: staking, transfers, P2P lending on Ethereum",
  "workspaces": [
    "contracts",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "compile": "npm run compile --workspace=@defi-app/contracts",
    "test": "npm run test --workspace=@defi-app/contracts",
    "coverage": "npm run test:coverage --workspace=@defi-app/contracts",
    "node": "npm run node --workspace=@defi-app/contracts",
    "deploy:local": "npm run deploy:local --workspace=@defi-app/contracts",
    "deploy:sepolia": "npm run deploy:sepolia --workspace=@defi-app/contracts",
    "dev": "npm run dev --workspace=@defi-app/frontend",
    "build": "npm run build --workspace=@defi-app/frontend",
    "typecheck": "npm run typecheck --workspace=@defi-app/frontend"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
