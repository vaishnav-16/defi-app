# ---------- Contract deployment secrets ----------
# Local dev doesn't need any of these — they're only used for testnets/mainnet.

# RPC endpoint for Sepolia testnet (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# Private key of the deployer account. NEVER commit this.
# Use a throwaway test account, never your main wallet.
PRIVATE_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Set to "true" to print a gas report after tests
REPORT_GAS=false
